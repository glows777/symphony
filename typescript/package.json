{
  "name": "symphony",
  "version": "0.1.0",
  "description": "TypeScript/Bun port of the Symphony agent-orchestration service (literal port of the Elixir reference implementation).",
  "type": "module",
  "private": true,
  "bin": {
    "symphony": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "start:symphony": "bun run src/cli.ts --i-understand-that-this-will-be-running-without-the-usual-guardrails --port 4000 --logs-root ./runtime/symphony ./WORKFLOW.md",
    "start:linear": "bun run start:symphony",
    "start:xz-system": "bun run src/cli.ts --i-understand-that-this-will-be-running-without-the-usual-guardrails --port 4001 --logs-root ./runtime/xz-system ../projects/xz-system/workflow.md",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "frontend:dev": "vite --config frontend/vite.config.ts",
    "frontend:dev:symphony": "SYMPHONY_API_ORIGIN=http://127.0.0.1:4000 bun run frontend:dev -- --port 5173",
    "frontend:dev:xz-system": "SYMPHONY_API_ORIGIN=http://127.0.0.1:4001 bun run frontend:dev -- --port 5174",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run frontend:typecheck && bun run lint && bun run test",
    "verify": "bun run scripts/verify.ts",
    "oracle:record-api": "bun harness/record-api.ts",
    "oracle:assert": "bun harness/assert-parity.ts"
  },
  "dependencies": {
    "liquidjs": "^10.21.1",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.1.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  }
}
